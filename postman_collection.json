{
  "info": {
    "name": "Content Upload & Review System",
    "description": "Upload movie CSVs and query the data. Set {{base_url}} (default http://localhost:5000).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000" },
    { "key": "job_id", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{base_url}}/health" }
    },
    {
      "name": "Upload CSV",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json.job_id) { pm.collectionVariables.set('job_id', json.job_id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/v1/uploads",
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "file", "type": "file", "src": "" }
          ]
        },
        "description": "Select a .csv file in the 'file' field. Returns 202 + job_id (saved to {{job_id}})."
      }
    },
    {
      "name": "Get Upload Status",
      "request": { "method": "GET", "url": "{{base_url}}/api/v1/uploads/{{job_id}}" }
    },
    {
      "name": "List Movies (default)",
      "request": { "method": "GET", "url": "{{base_url}}/api/v1/movies" }
    },
    {
      "name": "List Movies (filter + sort)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/v1/movies?language=en&year=1995&sort=ratings&order=desc&page=1&limit=20",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "movies"],
          "query": [
            { "key": "language", "value": "en" },
            { "key": "year", "value": "1995" },
            { "key": "sort", "value": "ratings" },
            { "key": "order", "value": "desc" },
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "20" }
          ]
        }
      }
    }
  ]
}
